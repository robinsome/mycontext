# 复制为 deploy/.env 后编辑。勿提交含真实 token 的 .env。
#
# 镜像（默认 GHCR；离线 docker load 后须改为本地名，见 docs/deploy/ubuntu-web.md）
# 在线 GHCR：MYCONTEXT_IMAGE=ghcr.io/robinsome/mycontext-web-server
# 离线 load：MYCONTEXT_IMAGE=mycontext-web-server
MYCONTEXT_IMAGE=ghcr.io/robinsome/mycontext-web-server
MYCONTEXT_IMAGE_TAG=0.1.0
# missing=有本地则不拉（离线 load 后保持 missing）；always=每次 pull（需已 docker login ghcr.io）
MYCONTEXT_PULL_POLICY=missing

# 同步 Bearer；留空则首次启动在数据卷内生成 sync-token（可在浏览器设置页轮换）
MYCONTEXT_SYNC_TOKEN=mc-sync-change-me

# 宿主机绑定地址（生产保持 127.0.0.1，仅本机反代可达；局域网调试可改为 0.0.0.0）
MYCONTEXT_PUBLISH_BIND=127.0.0.1

# 宿主机映射端口（默认 8787）
MYCONTEXT_PUBLISH_PORT=8787

# kl-server 同机监听端口（web-server 建图触发用；kl 未起则 graph/build 会失败）
KL_SERVER_PORT=8200

# 企业应用 OAuth（正式采集路径；勿提交真实 Secret）
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# DINGTALK_CORP_ID=
# OAUTH_REDIRECT_URI=https://example.com/api/v1/auth/callback

# dws sidecar（正式采集；须先在宿主机 build 或 docker load）
# MYCONTEXT_DWS_SIDECAR_IMAGE=mycontext-dws-sidecar:0.1.0
# MYCONTEXT_DWS_SIDECAR_MAX_CONCURRENT=2
# 容器内 web-server spawn sidecar 时必填：命名卷 mountpoint（docker volume inspect … --format '{{.Mountpoint}}'）
# 或 bind mount 开发时 data 目录的宿主机绝对路径。compose 会将其同路径 bind 进容器以便 --env-file。
# MYCONTEXT_HOST_DATA_DIR=/var/snap/docker/common/var-lib-docker/volumes/mycontext-web_mycontext-data/_data
