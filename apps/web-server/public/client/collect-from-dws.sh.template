#!/usr/bin/env bash
# MyContext 客户端采集（过渡）：本机 dws → POST /api/v1/channel-sync
# 由 Web 页面按当前登录态填写 URL/Token/Vault 后下载。勿把含 token 的副本提交进 git。
set -euo pipefail

MYCONTEXT_SYNC_URL="__SYNC_URL__"
MYCONTEXT_SYNC_TOKEN="__SYNC_TOKEN__"
MYCONTEXT_VAULT_ID="__VAULT_ID__"
MYCONTEXT_HOURS="__HOURS__"

if [[ "${1:-}" == "--hours" && -n "${2:-}" ]]; then
  MYCONTEXT_HOURS="$2"
fi

if [[ -z "$MYCONTEXT_SYNC_URL" || -z "$MYCONTEXT_SYNC_TOKEN" || -z "$MYCONTEXT_VAULT_ID" ]]; then
  echo "错误: Sync URL / Token / Vault ID 为空。请在 Web 页登录后再下载本脚本。" >&2
  exit 1
fi

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "错误: 未找到 $1。请先阅读 Web 页「客户端采集」说明。" >&2
    exit 1
  }
}

need curl
need python3

if ! command -v dws >/dev/null 2>&1; then
  echo "未找到 dws。请安装并登录：" >&2
  echo "  npm install -g dingtalk-workspace-cli@1.0.60" >&2
  echo "  dws auth login" >&2
  exit 1
fi

echo "探活: dws contact user get-self …" >&2
dws contact user get-self -f json >/dev/null

TMPDIR_RUN="$(mktemp -d "${TMPDIR:-/tmp}/mycontext-client-XXXXXX")"
cleanup() { rm -rf "$TMPDIR_RUN"; }
trap cleanup EXIT

echo "拉取会话 list-all-conversations（上限约 100，可能不全）…" >&2
dws chat list-all-conversations --limit 100 -f json >"$TMPDIR_RUN/conv.json"
echo "拉取群 list-all 首页…" >&2
dws chat group list-all --limit 100 -f json >"$TMPDIR_RUN/groups.json"

if [[ "$MYCONTEXT_HOURS" != "0" ]]; then
  echo "拉取近 ${MYCONTEXT_HOURS}h 消息 list-all 首页（完整抽干请用仓库 tsx --from-dws）…" >&2
  python3 - "$MYCONTEXT_HOURS" "$TMPDIR_RUN/window.txt" <<'PY'
import datetime, sys
hours=int(sys.argv[1])
end=datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=8)))
start=end-datetime.timedelta(hours=hours)
fmt=lambda d: d.strftime("%Y-%m-%d %H:%M:%S")
open(sys.argv[2],"w").write(f"{fmt(start)}\n{fmt(end)}\n")
PY
  START_STR="$(sed -n '1p' "$TMPDIR_RUN/window.txt")"
  END_STR="$(sed -n '2p' "$TMPDIR_RUN/window.txt")"
  dws chat message list-all --start "$START_STR" --end "$END_STR" --cursor 0 --limit 100 -f json \
    >"$TMPDIR_RUN/msg.json" || echo '{}' >"$TMPDIR_RUN/msg.json"
else
  echo "hours=0：只导会话，跳过消息" >&2
  echo '{}' >"$TMPDIR_RUN/msg.json"
fi

python3 - "$TMPDIR_RUN/conv.json" "$TMPDIR_RUN/groups.json" "$TMPDIR_RUN/msg.json" \
  "$TMPDIR_RUN/payload.json" "$MYCONTEXT_VAULT_ID" <<'PY'
import json, sys, time

def unwrap(doc):
  if isinstance(doc, dict) and isinstance(doc.get("result"), (dict, list)):
    return doc["result"]
  return doc

def load(path):
  with open(path, encoding="utf-8") as fh:
    raw = fh.read().strip()
  if not raw:
    return {}
  return unwrap(json.loads(raw))

conv, groups, msg = load(sys.argv[1]), load(sys.argv[2]), load(sys.argv[3])
out_path, vault_id = sys.argv[4], sys.argv[5]
by_id = {}

def put(raw, kind_default):
  cid = raw.get("openConversationId")
  if not isinstance(cid, str) or not cid:
    return
  if cid in by_id:
    return
  single = raw.get("groupType") == "SINGLE_CHAT" or raw.get("singleChat") is True
  by_id[cid] = {
    "id": "chat:" + cid.replace("/", "_"),
    "type": "chat",
    "parent_id": "workspace:ali-ding",
    "data": {
      "title": raw.get("title") or raw.get("name"),
      "chat_kind": "direct" if single else kind_default,
      "openConversationId": cid,
      "memberCount": raw.get("memberCount"),
    },
  }

for raw in conv.get("conversations") or []:
  if isinstance(raw, dict):
    put(raw, "group")
for raw in groups.get("groups") or []:
  if isinstance(raw, dict):
    put(raw, "group")

scopes = [{
  "id": "workspace:ali-ding",
  "type": "workspace",
  "parent_id": None,
  "data": {"title": "钉钉工作区"},
}]
scopes.extend(by_id.values())
records = []

def walk(node):
  if isinstance(node, list):
    for x in node:
      walk(x)
    return
  if not isinstance(node, dict):
    return
  msgs = node.get("messages")
  if isinstance(msgs, list):
    cid = node.get("openConversationId")
    for m in msgs:
      if not isinstance(m, dict):
        continue
      mid = m.get("openMessageId")
      ocid = m.get("openConversationId") or cid
      if not mid or not ocid:
        continue
      scope_id = "chat:" + str(ocid).replace("/", "_")
      records.append({
        "id": f"{scope_id}:{mid}",
        "scope_id": scope_id,
        "type": "message",
        "data": {
          "openMessageId": mid,
          "openConversationId": ocid,
          "content": m.get("content") or "",
          "createTime": m.get("createTime"),
          "sender": m.get("sender") or m.get("senderName") or "unknown",
          "senderOpenDingTalkId": m.get("senderOpenDingTalkId") or m.get("openDingTalkId"),
        },
      })
  for v in node.values():
    if isinstance(v, (dict, list)):
      walk(v)

if isinstance(msg, dict):
  walk(msg)

exported_at = int(time.time() * 1000)
chat_count = max(0, len(scopes) - 1)
manifest = {
  "source": "mycontext",
  "dataset": "chat",
  "scope_types": ["workspace", "chat"],
  "record_types": ["message"],
  "resource_kinds": [],
  "counts": {"scopes": chat_count, "records": len(records), "resources": 0},
  "exported_at": exported_at,
  "mycontext_bridge": {"client_script": "collect-from-dws.sh", "msg": "first page only"},
}

def lines(objs):
  return "".join(json.dumps(o, ensure_ascii=False) + "\n" for o in objs) if objs else ""

payload = {
  "manifest": {
    "vaultId": vault_id,
    "channelId": "dingtalk",
    "exportedAt": exported_at,
    "sources": ["chat"],
  },
  "files": {
    "chat/manifest.json": json.dumps(manifest, ensure_ascii=False, indent=2) + "\n",
    "chat/scopes.jsonl": lines(scopes),
    "chat/records.jsonl": lines(records),
    "chat/resources.jsonl": "",
  },
}
with open(out_path, "w", encoding="utf-8") as fh:
  json.dump(payload, fh, ensure_ascii=False)
print(f"组装完成: 会话 {chat_count}，消息 {len(records)}", file=sys.stderr)
PY

echo "POST ${MYCONTEXT_SYNC_URL} …" >&2
HTTP="$(
  curl -sS -o "$TMPDIR_RUN/resp.json" -w "%{http_code}" \
    -X POST "$MYCONTEXT_SYNC_URL" \
    -H "Authorization: Bearer ${MYCONTEXT_SYNC_TOKEN}" \
    -H "Content-Type: application/json" \
    --data-binary @"$TMPDIR_RUN/payload.json"
)"
echo "HTTP ${HTTP}" >&2
cat "$TMPDIR_RUN/resp.json" >&2 || true
echo >&2
[[ "$HTTP" == "200" ]] || { echo "同步失败" >&2; exit 1; }
echo "同步成功。请回 Web 页查看「同步状态」。" >&2
